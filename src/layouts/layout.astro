---
<html lang="en" class="h-full antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <link rel="icon" href="/logo.ico" />

<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-57XMH7ZT');</script>
<!-- End Google Tag Manager -->

</head>
<body class="min-h-full flex flex-col font-sans bg-white">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-57XMH7ZT"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <div class="bg-slate-900 text-slate-200 py-2 border-b border-slate-800 shrink-0">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center text-[12px] font-normal tracking-wide">
      <div class="flex items-center gap-6">
        <a href="mailto:info@kitchenandall.co.ke" class="hover:text-orange-400 transition-colors lowercase">info@kitchenandall.co.ke</a>
        <a href="tel:+254741045143" class="hidden sm:inline hover:text-orange-400 transition-colors">+254 741 045 143</a>
      </div>
      <div class="flex items-center gap-6">
        <div class="hidden lg:flex items-center gap-5 border-r border-slate-700 pr-6">
          {socialLinks.map(({ label, href }) => (
            <a href={href} target="_blank" rel="noreferrer" class="hover:text-orange-500 transition-colors">{label}</a>
          ))}
        </div>
        <a href="/get-quote" class="inline-flex items-center px-4 py-2 rounded-full bg-orange-600 text-white font-black uppercase tracking-widest hover:bg-orange-700 transition-colors">
          Get Quote
        </a>
      </div>
    </div>
  </div>

  <nav class="bg-white border-b sticky top-0 z-50 shadow-sm h-20 lg:h-24 flex items-center shrink-0">
    <div class="max-w-7xl mx-auto px-4 w-full flex items-center justify-between gap-4">
      <button
        type="button"
        id="mobile-menu-button"
        class="lg:hidden inline-flex h-11 w-11 shrink-0 items-center justify-center rounded border border-slate-200 text-slate-900 hover:border-orange-600 hover:text-orange-600 transition-colors"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>

      <a href="/" class="shrink-0 mr-4">
        <h1 class="text-xl md:text-2xl font-black text-slate-900 tracking-tighter uppercase">
          KITCHEN AND ALL
        </h1>
      </a>

      <div class="hidden lg:flex items-center flex-1 justify-center gap-1">
        <a href="/" class="px-3 py-2 font-black text-[11px] text-slate-800 hover:text-orange-600 uppercase">Home</a>

        <div class="group relative h-24 flex items-center mr-2">
          <button class="flex items-center gap-1.5 px-4 py-2 bg-slate-900 text-white rounded font-black text-[10px] hover:bg-orange-600 transition-all uppercase tracking-widest">
            All Equipment
          </button>
          <div class="absolute top-24 left-0 w-64 bg-white border border-slate-100 shadow-2xl rounded-b-2xl py-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            {allEquipmentItems.map((item) => (
              <a href={`/category/${slugify(item)}`} class="block px-6 py-2.5 text-[11px] font-black text-slate-800 hover:text-orange-600 uppercase transition-colors">{item}</a>
            ))}
          </div>
        </div>

        {navCategories.map((cat) => (
          <div class="group relative h-24 flex items-center">
            <button class="px-3 py-2 font-bold text-[11px] text-slate-600 group-hover:text-orange-600 uppercase">{cat.name}</button>
            <div class="absolute top-24 left-1/2 -translate-x-1/2 w-64 bg-white border shadow-2xl rounded-b-2xl py-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
              {cat.subcategories.map((sub) => (
                <a href={`/category/${slugify(sub)}`} class="block px-6 py-2.5 text-[12px] text-slate-600 hover:text-orange-600 border-l-4 border-transparent hover:border-orange-600 font-bold uppercase transition-all">{sub}</a>
              ))}
            </div>
          </div>
        ))}

        <div class="w-full max-w-[220px] ml-4">
          <SearchBar client:load />
        </div>
      </div>

      <div class="flex items-center ml-2">
        <CartDrawer client:load />
      </div>
    </div>
  </nav>

  <div id="mobile-navigation" class="fixed inset-0 z-[60] invisible opacity-0 transition-opacity duration-200 lg:hidden" aria-hidden="true">
    <button type="button" class="absolute inset-0 bg-slate-950/50" data-mobile-menu-close aria-label="Close navigation menu"></button>
    <aside class="relative h-full w-[min(20rem,88vw)] overflow-y-auto bg-white px-6 pb-8 pt-5 shadow-2xl -translate-x-full transition-transform duration-200" data-mobile-menu-panel>
      <div class="flex items-center justify-between border-b border-slate-200 pb-5">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-900">Navigation</p>
        <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded text-slate-700 hover:bg-slate-100 hover:text-orange-600" data-mobile-menu-close aria-label="Close navigation menu">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="mt-5 space-y-1">
        <a href="/" class="block border-b border-slate-100 py-3 text-sm font-black uppercase text-slate-900 hover:text-orange-600">Home</a>
        <details class="group border-b border-slate-100 py-3">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-black uppercase text-slate-900 hover:text-orange-600">
            All Equipment
            <span class="text-lg leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-2 space-y-1 pl-3">
            {allEquipmentItems.map((item) => (
              <a href={`/category/${slugify(item)}`} class="block py-2 text-xs font-bold uppercase text-slate-600 hover:text-orange-600">{item}</a>
            ))}
          </div>
        </details>

        {navCategories.map((cat) => (
          <details class="group border-b border-slate-100 py-3">
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-bold uppercase text-slate-700 hover:text-orange-600">
              {cat.name}
              <span class="text-lg leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="mt-2 space-y-1 border-l-2 border-orange-600 pl-3">
              {cat.subcategories.map((sub) => (
                <a href={`/category/${slugify(sub)}`} class="block py-2 text-xs font-bold uppercase text-slate-600 hover:text-orange-600">{sub}</a>
              ))}
            </div>
          </details>
        ))}

        <a href="/blogs" class="block border-b border-slate-100 py-3 text-sm font-black uppercase text-slate-900 hover:text-orange-600">Blogs</a>
        <a href="/get-quote" class="mt-5 block rounded bg-orange-600 px-4 py-3 text-center text-xs font-black uppercase tracking-widest text-white hover:bg-orange-700">Get Quote</a>
      </div>
    </aside>
  </div>

  <script is:inline>
    const mobileMenu = document.getElementById('mobile-navigation');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenuPanel = mobileMenu?.querySelector('[data-mobile-menu-panel]');
    const mobileMenuCloseButtons = mobileMenu?.querySelectorAll('[data-mobile-menu-close]');

    const setMobileMenuOpen = (isOpen) => {
      if (!mobileMenu || !mobileMenuButton || !mobileMenuPanel) return;
      mobileMenu.classList.toggle('invisible', !isOpen);
      mobileMenu.classList.toggle('opacity-0', !isOpen);
      mobileMenuPanel.classList.toggle('-translate-x-full', !isOpen);
      mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
      mobileMenuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      document.body.classList.toggle('overflow-hidden', isOpen);
    };

    mobileMenuButton?.addEventListener('click', () => setMobileMenuOpen(true));
    mobileMenuCloseButtons?.forEach((button) => button.addEventListener('click', () => setMobileMenuOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuOpen(false);
    });
  </script>

  <main class="flex-grow">
    <slot />
  </main>

  <footer class="bg-slate-900 rounded-t-[2rem] border-t border-slate-800 text-slate-300 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <div class="grid gap-10 lg:grid-cols-4">
        <div class="space-y-4">
          <p class="text-orange-500 uppercase tracking-[0.35em] text-xs font-black">Kitchen And All</p>
          <p class="max-w-sm text-slate-400 leading-relaxed">Commercial kitchen equipment, design, and installation services built around hospitality and foodservice businesses in Kenya.</p>
        </div>

        <div>
          <h3 class="text-white font-black uppercase tracking-widest text-sm mb-4">Quick links</h3>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li><a href="/" class="hover:text-orange-500 transition-colors">Home</a></li>
            <li><a href="/blogs" class="hover:text-orange-500 transition-colors">Blogs</a></li>
            <li><a href="/get-quote" class="hover:text-orange-500 transition-colors">Get Quote</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white font-black uppercase tracking-widest text-sm mb-4">Policy</h3>
          <ul class="space-y-3 text-slate-400 text-sm">
            <li><a href="/privacy" class="hover:text-orange-500 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-orange-500 transition-colors">Terms of Service</a></li>
            <li><a href="/shipping" class="hover:text-orange-500 transition-colors">Shipping Policy</a></li>
            <li><a href="/returns" class="hover:text-orange-500 transition-colors">Returns Policy</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white font-black uppercase tracking-widest text-sm mb-4">Contact us</h3>
          <div class="space-y-4 text-sm text-slate-400">
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">Location</p>
              <p class="mt-2">Juakali, along Landhies Road, next to the former Kenya Meat Commission (KMC) site, Nairobi</p>
            </div>
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">WhatsApp</p>
              <a href="https://wa.me/254741045143" target="_blank" class="mt-2 block hover:text-orange-500 transition-colors">+254 741 045 143</a>
            </div>
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">Email</p>
              <a href="mailto:info@kitchenandall.co.ke" class="mt-2 block hover:text-orange-500 transition-colors">info@kitchenandall.co.ke</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-6 border-t border-slate-800 pt-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-4 text-slate-400">
          {socialLinks.map(({ label, href, icon }) => (
            <a href={href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 hover:text-orange-500 transition-colors">
              <Fragment set:html={icon} />
              {label}
            </a>
          ))}
        </div>
        <p class="text-slate-500 text-[11px] uppercase tracking-[0.35em] font-black">© 2026 Kitchen And All Ltd.</p>
      </div>
    </div>
  </footer>

  <FloatingWhatsApp client:load isProductPage={isProductPage} />
</body>
</html>