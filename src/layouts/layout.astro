            <li><a href="/terms" class="hover:text-orange-500 transition-colors">Terms of Service</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white font-black uppercase tracking-widest text-sm mb-4">Contact us</h3>
          <div class="space-y-4 text-sm text-slate-400">
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">Location</p>
              <p class="mt-2">Ruiru Workshop, Kiambu County, Kenya</p>
            </div>
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">WhatsApp</p>
              <a href="https://wa.me/254741045143" target="_blank" class="mt-2 block hover:text-orange-500 transition-colors">+254 741 045 143</a>
            </div>
            <div>
              <p class="font-black text-slate-100 uppercase tracking-widest text-[10px]">Email</p>
              <a href="mailto:Mugambievelyn812@gmail.com" class="mt-2 block hover:text-orange-500 transition-colors">Mugambievelyn812@gmail.com</a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-6 border-t border-slate-800 pt-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-4 text-slate-400">
          <a href="https://www.facebook.com/Kitchenandall" target="_blank" class="inline-flex items-center gap-2 hover:text-orange-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2.5v-2.9h2.5V9.2c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.3.2 2.3.2v2.5h-1.3c-1.3 0-1.7.8-1.7 1.7v2h2.9l-.5 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
            Facebook
          </a>
          <a href="https://www.tiktok.com/@kitchenandall" target="_blank" class="inline-flex items-center gap-2 hover:text-orange-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M9 3v8.8a3.2 3.2 0 0 0 3.2 3.2 3.2 3.2 0 0 0 3.2-3.2V6.6h2.7v3.1a6 6 0 1 1-6 6V3H9Z"/></svg>
            TikTok
          </a>
          <a href="https://www.instagram.com/kitch_enandall" target="_blank" class="inline-flex items-center gap-2 hover:text-orange-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5Zm8.75 2.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm-4 1.3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/></svg>
            Instagram
          </a>
          <a href="https://wa.me/254741045143" target="_blank" class="inline-flex items-center gap-2 hover:text-orange-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.86 11.86 0 0 0 12 0C5.37 0 0 5.37 0 12c0 2 .52 3.87 1.48 5.53L0 24l6.70-1.76A11.93 11.93 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.18-3.48-8.52Zm-2.55 13.8c-.28.80-1.66 1.53-2.29 1.63-.60.10-1.30.15-2.00.07-1.55-.16-3.04-.87-4.45-1.70-1.41-.84-2.69-1.87-3.58-3.19-.77-1.12-1.19-2.39-1.24-3.66-.07-1.52.37-2.84 1.41-3.86.13-.13.28-.27.42-.40.22-.20.37-.27.64-.16.76.29 1.53.66 2.22 1.08.27.17.41.25.64.09.65-.42 1.21-1.03 1.71-1.58.19-.21.08-.30-.03-.45-.50-.64-1.01-1.28-1.54-1.90-.20-.23-.42-.44-.63-.67-.14-.16-.27-.24-.50-.14-1.25.61-2.29 1.43-3.16 2.46-.80.97-1.30 2.10-1.38 3.31-.12 1.73.34 3.38 1.26 4.86 1.25 2.19 3.26 3.86 5.58 4.63 1.72.55 3.53.59 5.24.18 1.12-.28 2.14-.84 3.02-1.54.12-.10.20-.20.06-.35-1.42-1.71-2.80-3.46-4.19-5.20-.11-.13-.21-.19-.41-.08Z"/></svg>
