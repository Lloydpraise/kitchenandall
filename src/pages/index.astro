---
import Layout from '../layouts/layout.astro';
import HeroSlider from '../components/heroSlider';
import AnimatedBanner from '../components/AnimatedBanner';
import ProductCard from '../components/productCard';
import { supabase } from '../lib/supabase';

const categoryNames = ["Cooking", "Refrigeration", "Food Prep", "Stainless Steel"];

const { data: allCategoryProducts, error: categoryImageError } = await supabase
  .from('products')
  .select('*')
  .in('major_category', categoryNames)
  .order('id', { ascending: true });

if (categoryImageError) console.error('Category image lookup error:', categoryImageError);

const navCategories = categoryNames.map((name) => {
  const firstProduct = (allCategoryProducts || []).find((product) => product.major_category === name);

  return {
    name,
    img: firstProduct?.image_url || `/images/categories/${name.toLowerCase().replace(/\s+/g, '-')}.jpg`
  };
});

const { data: featuredProducts, error } = await supabase
  .from('products')
  .select('*')
  .limit(8);

if (error) console.error('Featured products error:', error);
---
<Layout>
  <div class="relative min-h-screen bg-slate-50">
    <section class="h-[650px] w-full bg-[#0F172A] overflow-hidden">
      <HeroSlider client:load />
    </section>

    <section class="max-w-7xl mx-auto px-4 -mt-12 relative z-20 grid grid-cols-2 lg:grid-cols-4 gap-6">
      {navCategories.map((cat) => (
        <a href={`/category/${cat.name.toLowerCase().replace(' ', '-')}`} class="group relative h-48 rounded-2xl overflow-hidden cursor-pointer shadow-2xl border-4 border-white">
          <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${cat.img}')`}></div>
          <div class="absolute inset-0 bg-slate-900/40 group-hover:bg-orange-600/70 transition-colors duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <h3 class="text-white font-black uppercase tracking-tighter text-xl">{cat.name}</h3>
          </div>
        </a>
      ))}
    </section>

    <main class="max-w-7xl mx-auto px-4 py-24">
      <div class="flex items-end justify-between mb-12 border-b border-slate-200 pb-4">
        <div>
          <h3 class="text-3xl font-black text-slate-900 uppercase tracking-tight">Essential Kitchen Gear</h3>
          <div class="h-1.5 w-20 bg-orange-600 mt-2"></div>
        </div>
        <a href="/catalog" class="text-orange-600 font-black uppercase text-sm tracking-widest hover:underline">View All</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {(featuredProducts || []).map((product) => (
          <ProductCard product={product} client:visible />
        ))}
      </div>
    </main>

    <AnimatedBanner client:visible />

    <section class="bg-white py-24 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl font-black text-slate-900 uppercase tracking-tighter mb-16">Connect With Us</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 text-left">
          <div class="bg-slate-50 p-12 rounded-3xl border border-slate-100 shadow-sm">
            <h4 class="text-orange-600 font-black uppercase tracking-widest text-sm mb-6">Support & Sales</h4>
            <p class="font-bold text-slate-800 text-xl">WhatsApp: <a href="https://wa.me/254741045143" target="_blank" class="hover:text-orange-600">+254 741 045 143</a></p>
            <p class="font-bold text-slate-800 text-xl mt-4">Email: <a href="mailto:info@kitchenandall.co.ke" class="hover:text-orange-600 transition-colors">info@kitchenandall.co.ke</a></p>
            <p class="font-bold text-slate-800 text-xl mt-4">Location: Juakali, along Landhies Road, next to the former Kenya Meat Commission (KMC) site, Nairobi</p>
          </div>
          <div class="bg-slate-50 p-12 rounded-3xl border border-slate-100 shadow-sm">
            <h4 class="text-orange-600 font-black uppercase tracking-widest text-sm mb-6">Need Help?</h4>
            <p class="text-slate-600 text-lg leading-relaxed">Send your project details and we’ll get back to you quickly with a tailored plan and pricing.</p>
            <div class="mt-8 space-y-4 text-slate-800">
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Phone</p>
                <a href="tel:+254741045143" class="mt-2 block hover:text-orange-600">+254 741 045 143</a>
              </div>
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Email</p>
                <a href="mailto:info@kitchenandall.co.ke" class="mt-2 block hover:text-orange-600">info@kitchenandall.co.ke</a>
              </div>
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Location</p>
                <p class="mt-2">Juakali, along Landhies Road, next to the former Kenya Meat Commission (KMC) site, Nairobi</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>