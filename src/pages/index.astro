---
import Layout from '../layouts/layout.astro';
import HeroSlider from '../components/heroSlider';
import AnimatedBanner from '../components/AnimatedBanner';
import ProductCard from '../components/productCard';
import { supabase } from '../lib/supabase';
import { categories, categoryUrl } from '../lib/categories';

// One photo per category: the first product in it
const { data: categoryProducts, error: categoryImageError } = await supabase
  .from('products')
  .select('major_category, image_url')
  .in('major_category', categories.map((c) => c.name))
  .order('id', { ascending: true });

if (categoryImageError) console.error('Category image lookup error:', categoryImageError);

const categoryTiles = categories.map((c) => ({
  ...c,
  img: (categoryProducts || []).find((p) => p.major_category === c.name && p.image_url)?.image_url,
}));

const { data: featuredProducts, error } = await supabase
  .from('products')
  .select('*')
  .limit(8);

if (error) console.error('Featured products error:', error);
---
<Layout>
  <div class="relative min-h-screen bg-slate-50">
    <section class="h-[650px] w-full bg-[#0F172A] overflow-hidden">
      <HeroSlider client:load />
    </section>

    <section class="max-w-7xl mx-auto px-4 -mt-12 relative z-20" aria-label="Shop by category">
      <div class="relative">
        <div data-cat-scroller class="grid grid-flow-col grid-rows-2 lg:grid-rows-1 auto-cols-[44%] sm:auto-cols-[30%] lg:auto-cols-[calc((100%-4.5rem)/4)] gap-3 sm:gap-4 lg:gap-6 overflow-x-auto snap-x snap-mandatory py-2 -my-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {categoryTiles.map((cat) => (
            <a href={categoryUrl(cat)} class="group relative h-36 sm:h-44 lg:h-52 snap-start rounded-2xl overflow-hidden shadow-md border-4 border-white bg-slate-700">
              {cat.img && <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${cat.img}')`}></div>}
              <div class="absolute inset-0 bg-slate-900/50 group-hover:bg-orange-600/80 transition-colors duration-500"></div>
              <h2 class="absolute inset-x-3 bottom-3 lg:inset-x-4 lg:bottom-4 text-white font-black uppercase tracking-tight text-sm sm:text-base lg:text-xl leading-tight">{cat.name}</h2>
            </a>
          ))}
        </div>
        <button type="button" data-cat-prev aria-label="Previous categories" class="hidden lg:flex absolute -left-5 top-1/2 -translate-y-1/2 h-11 w-11 items-center justify-center rounded-full bg-white text-slate-900 shadow-xl border border-slate-200 hover:text-orange-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" data-cat-next aria-label="More categories" class="hidden lg:flex absolute -right-5 top-1/2 -translate-y-1/2 h-11 w-11 items-center justify-center rounded-full bg-white text-slate-900 shadow-xl border border-slate-200 hover:text-orange-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </section>
    <script is:inline>
      (() => {
        const row = document.querySelector('[data-cat-scroller]');
        const step = () => (row ? row.clientWidth * 0.75 : 0);
        document.querySelector('[data-cat-prev]')?.addEventListener('click', () => row?.scrollBy({ left: -step(), behavior: 'smooth' }));
        document.querySelector('[data-cat-next]')?.addEventListener('click', () => row?.scrollBy({ left: step(), behavior: 'smooth' }));
      })();
    </script>

    <main class="max-w-7xl mx-auto px-4 py-24">
      <div class="flex items-end justify-between mb-12 border-b border-slate-200 pb-4">
        <div>
          <h3 class="text-3xl font-black text-slate-900 uppercase tracking-tight">Essential Kitchen Gear</h3>
          <div class="h-1.5 w-20 bg-orange-600 mt-2"></div>
        </div>
        <a href="/catalog" class="text-orange-600 font-black uppercase text-sm tracking-widest hover:underline">View All</a>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 lg:gap-6">
        {(featuredProducts || []).map((product) => (
          <ProductCard product={product} client:visible />
        ))}
      </div>
    </main>

    <AnimatedBanner client:visible />

    <section class="bg-white py-24 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl font-black text-slate-900 uppercase tracking-tighter mb-16">Connect With Us</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 text-left">
          <div class="bg-slate-50 p-12 rounded-3xl border border-slate-100 shadow-sm">
            <h4 class="text-orange-600 font-black uppercase tracking-widest text-sm mb-6">Support & Sales</h4>
            <p class="font-bold text-slate-800 text-xl">WhatsApp: <a href="https://wa.me/254741045143" target="_blank" class="hover:text-orange-600">+254 741 045 143</a></p>
            <p class="font-bold text-slate-800 text-xl mt-4">Email: <a href="mailto:info@kitchenandall.co.ke" class="hover:text-orange-600 transition-colors">info@kitchenandall.co.ke</a></p>
            <p class="font-bold text-slate-800 text-xl mt-4">Location: Juakali, along Landhies Road, next to the former Kenya Meat Commission (KMC) site, Nairobi</p>
          </div>
          <div class="bg-slate-50 p-12 rounded-3xl border border-slate-100 shadow-sm">
            <h4 class="text-orange-600 font-black uppercase tracking-widest text-sm mb-6">Need Help?</h4>
            <p class="text-slate-600 text-lg leading-relaxed">Send your project details and we’ll get back to you quickly with a tailored plan and pricing.</p>
            <div class="mt-8 space-y-4 text-slate-800">
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Phone</p>
                <a href="tel:+254741045143" class="mt-2 block hover:text-orange-600">+254 741 045 143</a>
              </div>
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Email</p>
                <a href="mailto:info@kitchenandall.co.ke" class="mt-2 block hover:text-orange-600">info@kitchenandall.co.ke</a>
              </div>
              <div>
                <p class="font-black uppercase tracking-widest text-[10px] text-slate-500">Location</p>
                <p class="mt-2">Juakali, along Landhies Road, next to the former Kenya Meat Commission (KMC) site, Nairobi</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>