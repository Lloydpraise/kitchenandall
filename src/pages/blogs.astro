---
import Layout from '../layouts/layout.astro';
---

<Layout>
  <section class="min-h-[60vh] bg-slate-50 px-4 py-28">
    <div class="mx-auto max-w-4xl rounded-[2rem] bg-white border border-slate-200 p-14 shadow-2xl text-center">
      <p class="text-sm uppercase tracking-[0.35em] text-orange-600 font-black">Blogs</p>
      <h1 class="mt-6 text-4xl font-black text-slate-900">Insights and kitchen design guides</h1>
      <p class="mt-6 text-slate-600 leading-relaxed">This page is a placeholder for your blog content. Add articles about kitchen equipment, design inspiration, and commercial kitchen planning here later.</p>
    </div>
  </section>
</Layout>
