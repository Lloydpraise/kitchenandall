---
// Hub page for "commercial kitchen equipment nairobi", "catering equipment kenya", "kitchen equipment suppliers in nairobi"
// and "commercial ovens kenya" (Search Console, Nov 2026: impressions at positions 58 to 92 with no page made for them).
// The price table is built live from the products, so only the words need editing.
export const prerender = false;

import Layout from '../layouts/layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { supabase } from '../lib/supabase';
import { categories, categoryUrl } from '../lib/categories';
import { guideHtml, plainText } from '../lib/categoryGuides';

const siteUrl = 'https://kitchenandall.co.ke';
const path = '/commercial-kitchen-equipment-nairobi';

const { data, error } = await supabase.from('products').select('major_category, price');
if (error) console.error('Nairobi hub query error:', error);
const kes = (n: number) => `KES ${Math.round(n).toLocaleString('en-US')}`;
const rows = categories.flatMap((c) => {
  const prices = (data || []).filter((p) => p.major_category === c.name && Number(p.price) > 0).map((p) => Number(p.price));
  if (!prices.length) return [];
  return [{ name: c.name, href: categoryUrl(c), from: kes(Math.min(...prices)), count: prices.length }];
});

const sections = [
  {
    heading: 'One Nairobi supplier for the whole kitchen',
    body: `Kitchen And All supplies commercial kitchen equipment to hotels, restaurants, schools, hospitals, bakeries, butcheries and caterers from our base in Nairobi. We make most of our stainless steel equipment in our own workshop, so we can build to the size of your room and the way your team works, and we stock the machines that cannot be made locally.

Whether you are opening a new restaurant, fitting out a school kitchen or replacing one worn out cooker, you deal with one team from planning to delivery.`,
  },
  {
    heading: 'Commercial kitchen equipment we supply',
    body: `- **Cooking:** [gas cookers and burners](/category/cooking-equipment/gas-cookers), [commercial cooking ranges](/category/cooking-equipment/cooking-ranges), [deep fryers and chips fryers](/category/cooking-equipment/deep-fryers), griddles, shawarma and rotisserie machines.
- **Jikos and firewood stoves:** [institutional firewood jikos](/category/jikos/institutional-jikos) with chimneys for schools and hospitals, charcoal jikos and firewood boilers.
- **Commercial ovens:** [electric and gas deck ovens](/category/bakery-equipment/baking-ovens), pizza ovens, tandoor ovens and [charcoal ovens](/category/bakery-equipment/charcoal-ovens).
- **Food warmers and display:** [bain marie](/category/food-warmers/bain-marie), [display warmers](/category/food-warmers/food-display-warmers), [glass display counters](/category/food-warmers/display-counters) and hot cupboards.
- **Bakery, butchery and food processing:** [bakery equipment](/category/bakery-equipment), [butchery equipment](/category/butchery-equipment) and [food processing machines](/category/food-processing).
- **Stainless steel fabrication:** [sinks](/category/stainless-steel-sinks), [work tables, shelves and trolleys](/category/tables-storage), [kitchen hoods and grease traps](/category/kitchen-hoods-ventilation) and [hospital equipment](/category/hospital-equipment).`,
  },
  {
    heading: 'Catering equipment for hotels, schools and events',
    body: `Catering equipment in Kenya has to cope with long hours and large numbers. For hotels and restaurants we usually start with the cooking line, a bain marie or hot cupboard for service, and stainless steel sinks and tables that pass public health inspection. For schools, colleges and hospitals, energy saving institutional jikos and large boilers cut firewood costs. Event caterers often add mobile bain maries, trolleys and charcoal grills.`,
  },
  {
    heading: 'How we work',
    body: `- **Plan:** share your menu, the number of meals a day and your room size, and we suggest the equipment and layout.
- **Quote:** you get a clear quote with prices for each item. Many items show their price on this site.
- **Make and deliver:** stock items go out quickly, made to size items are built in our workshop. Delivery is free within Nairobi and we ship across Kenya.
- **Support:** our team stays available after delivery for advice and service.`,
  },
];

const faqs = [
  { q: 'Where can I buy commercial kitchen equipment in Nairobi?', a: 'You can order from Kitchen And All online, on WhatsApp on +254 741 045 143, or by asking for a quote on this site. We supply hotels, restaurants, schools and hospitals across Nairobi with free delivery within the city.' },
  { q: 'Do you deliver catering equipment outside Nairobi?', a: 'Yes. We ship commercial kitchen and catering equipment to towns across Kenya. Ask us for a delivery quote to your location.' },
  { q: 'Can you make kitchen equipment to fit my space?', a: 'Yes. Sinks, tables, shelves, hoods, bain maries, jikos and many other items are made in our Nairobi stainless steel workshop to the size you need.' },
  { q: 'How much does it cost to equip a commercial kitchen in Kenya?', a: 'It depends on how many meals you serve and what you cook. The table on this page shows the starting price for each type of equipment, and we can put together a full quote for your kitchen.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: plainText(f.q), acceptedAnswer: { '@type': 'Answer', text: plainText(f.a) } })),
};
---

<Layout
  title="Commercial Kitchen Equipment Nairobi | Catering Equipment Kenya"
  description="Commercial kitchen and catering equipment supplier in Nairobi: cookers, ovens, bain marie, jikos, sinks and stainless steel made to size. Free Nairobi delivery."
  canonicalUrl={`${siteUrl}${path}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="bg-slate-50">
    <section class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 py-8 lg:py-12">
        <Breadcrumbs items={[{ name: 'Commercial Kitchen Equipment Nairobi' }]} />
        <h1 class="mt-5 text-3xl lg:text-4xl font-black text-slate-900 uppercase tracking-tight">Commercial Kitchen Equipment in Nairobi</h1>
        <div class="h-1.5 w-20 bg-orange-600 mt-3"></div>
        <p class="mt-5 max-w-3xl text-slate-600 leading-relaxed">
          Cookers, commercial ovens, bain maries, jikos, sinks, tables and custom stainless steel for hotels, restaurants, schools, hospitals and caterers across Kenya, from one Nairobi supplier with free delivery in the city.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/get-quote" class="inline-flex rounded-full bg-orange-600 px-6 py-3 text-xs font-black uppercase tracking-widest text-white hover:bg-orange-700">Get a quote</a>
          <a href="/category" class="inline-flex rounded-full border border-slate-300 px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-800 hover:border-orange-600 hover:text-orange-600">Shop by category</a>
        </div>
      </div>
    </section>

    <main class="max-w-7xl mx-auto px-4 py-12">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div class="min-w-0 space-y-8 text-slate-600 leading-relaxed">
          {sections.map((s) => (
            <section>
              <h2 class="text-xl font-black text-slate-900">{s.heading}</h2>
              <div class="mt-3 space-y-3" set:html={guideHtml(s.body)} />
            </section>
          ))}
        </div>
        {rows.length > 0 && (
          <aside class="self-start rounded-2xl bg-white border border-slate-200 p-5">
            <h2 class="text-sm font-black uppercase tracking-widest text-slate-900">Kitchen equipment prices in Kenya</h2>
            <table class="mt-4 w-full text-sm">
              <thead class="sr-only"><tr><th>Category</th><th>Starting price</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-t border-slate-200 align-top">
                    <td class="py-2.5 pr-3">
                      <a href={r.href} class="font-semibold text-slate-800 hover:text-orange-600">{r.name}</a>
                      <div class="text-xs text-slate-500">{r.count} product{r.count === 1 ? '' : 's'}</div>
                    </td>
                    <td class="py-2.5 text-right font-black text-slate-900 whitespace-nowrap">From {r.from}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-4 text-xs text-slate-500">Prices on the site today. Made to size items are quoted on request.</p>
          </aside>
        )}
      </div>

      <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 lg:p-10">
        <h2 class="text-xl font-black text-slate-900">Frequently asked questions</h2>
        <div class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-bold text-slate-800 group-open:text-orange-600">{f.q}</summary>
              <div class="mt-2 text-slate-600 leading-relaxed" set:html={guideHtml(f.a)} />
            </details>
          ))}
        </div>
      </section>
    </main>
  </div>
</Layout>
