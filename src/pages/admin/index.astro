---
import { COOKIE, isAuthed } from '../../lib/adminAuth';
import { getEnv } from '../../lib/adminEnv';

export const prerender = false;

const token = getEnv('ADMIN_TOKEN');
const authed = await isAuthed(Astro.cookies.get(COOKIE)?.value, token);
const error = Astro.url.searchParams.get('error');
const notConfigured = !token;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin · Kitchen And All</title>
  <style is:inline>
    :root { --bg:#f6f6f4; --card:#fff; --ink:#1b1b1b; --muted:#6b6b6b; --line:#e3e3df; --brand:#b45309; --ok:#15803d; --bad:#b91c1c; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background:var(--bg); color:var(--ink); }
    header { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:var(--card); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:5; }
    header h1 { font-size:16px; margin:0; }
    main { max-width:1000px; margin:0 auto; padding:16px; }
    button { font:inherit; cursor:pointer; border-radius:8px; border:1px solid var(--line); background:var(--card); padding:8px 12px; }
    button.primary { background:var(--brand); border-color:var(--brand); color:#fff; }
    button:disabled { opacity:.5; cursor:default; }
    input[type=text], input[type=password], input[type=search] { font:inherit; width:100%; padding:10px; border:1px solid var(--line); border-radius:8px; background:#fff; }
    .login { max-width:360px; margin:15vh auto; background:var(--card); padding:24px; border-radius:12px; border:1px solid var(--line); }
    .login h1 { margin:0 0 4px; font-size:20px; } .login p { color:var(--muted); margin:0 0 16px; font-size:14px; }
    .login button { width:100%; margin-top:12px; padding:10px; }
    .msg { padding:10px 12px; border-radius:8px; margin-bottom:12px; font-size:14px; background:#fef2f2; color:var(--bad); }
    .bar { display:flex; gap:8px; align-items:center; margin-bottom:12px; }
    .count { color:var(--muted); font-size:13px; margin-bottom:8px; }
    .card { display:grid; grid-template-columns:240px 1fr; gap:20px; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-bottom:16px; }
    .thumb { width:100%; aspect-ratio:1 / 1; border-radius:10px; background:#eee center/cover no-repeat; border:1px solid var(--line); position:relative; cursor:pointer; overflow:hidden; }
    .thumb .empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:var(--muted); font-size:14px; }
    .thumb .chg { position:absolute; inset:auto 0 0 0; background:rgba(0,0,0,.6); color:#fff; font-size:14px; font-weight:600; text-align:center; padding:10px 0; }
    .fields { min-width:0; display:flex; flex-direction:column; gap:14px; }
    label.lbl { display:block; font-size:13px; font-weight:600; color:var(--muted); margin-bottom:6px; }
    textarea.name { font:inherit; font-size:18px; line-height:1.4; width:100%; min-height:84px; padding:12px; border:1px solid var(--line); border-radius:10px; resize:vertical; background:#fff; }
    input.price { font-size:22px !important; font-weight:600; padding:12px !important; }
    textarea:focus, input:focus { outline:2px solid var(--brand); outline-offset:1px; }
    .meta { font-size:13px; color:var(--muted); }
    .foot { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:auto; }
    .foot button { padding:7px 16px; font-size:14px; }
    .status { font-size:14px; min-height:18px; } .status.ok { color:var(--ok); } .status.bad { color:var(--bad); }
    .more { text-align:center; margin:16px 0; }
    @media (max-width:640px) { main { padding:12px; } .card { grid-template-columns:1fr; gap:14px; padding:12px; } .thumb { aspect-ratio:4 / 3; } textarea.name { font-size:17px; } }
  </style>
</head>
<body>
  {!authed ? (
    <form class="login" method="post" action="/api/admin/login">
      <h1>Kitchen And All</h1>
      <p>Admin sign in</p>
      {notConfigured && <div class="msg">ADMIN_TOKEN is not set in .env, so sign in is switched off.</div>}
      {error === '1' && <div class="msg">That token is not correct.</div>}
      {error === 'wait' && <div class="msg">Too many wrong tries. Wait 10 minutes and try again.</div>}
      <input type="password" name="token" placeholder="Admin token" autocomplete="current-password" required autofocus />
      <button class="primary" type="submit">Sign in</button>
    </form>
  ) : (
    <>
      <header>
        <h1>Products</h1>
        <form method="post" action="/api/admin/logout"><button type="submit">Sign out</button></form>
      </header>
      <main>
        <div id="note"></div>
        <div class="bar"><input id="q" type="search" placeholder="Search products by name…" /></div>
        <div id="count" class="count">Loading…</div>
        <div id="list"></div>
        <div class="more"><button id="more" hidden>Show more</button></div>
        <input id="file" type="file" accept="image/jpeg,image/png,image/webp" hidden />
      </main>
      <script is:inline>
        (function () {
          var H = { 'x-requested-with': 'kna-admin' };
          var PAGE = 20, all = [], shown = PAGE, query = '', pickFor = null;
          var $ = function (id) { return document.getElementById(id); };

          function api(url, opts) {
            opts = opts || {};
            opts.headers = Object.assign({}, H, opts.headers || {});
            return fetch(url, opts).then(function (r) {
              if (r.status === 401) { location.href = '/admin'; throw new Error('Please sign in again'); }
              return r.json().then(function (b) { if (!r.ok) throw new Error(b.error || 'Something went wrong'); return b; });
            });
          }

          function filtered() {
            var q = query.trim().toLowerCase();
            return q ? all.filter(function (p) { return (p.name || '').toLowerCase().indexOf(q) !== -1; }) : all;
          }

          function render() {
            var items = filtered(), list = $('list');
            list.textContent = '';
            items.slice(0, shown).forEach(function (p) { list.appendChild(row(p)); });
            $('count').textContent = items.length + ' product' + (items.length === 1 ? '' : 's');
            $('more').hidden = items.length <= shown;
          }

          function setStatus(el, text, ok) { el.textContent = text; el.className = 'status ' + (ok ? 'ok' : 'bad'); }

          function grow(t) { t.style.height = 'auto'; t.style.height = Math.max(84, t.scrollHeight + 2) + 'px'; }

          function field(labelText, input) {
            var w = document.createElement('div');
            var l = document.createElement('label'); l.className = 'lbl'; l.textContent = labelText;
            w.appendChild(l); w.appendChild(input); return w;
          }

          function row(p) {
            var r = document.createElement('div'); r.className = 'card';

            var th = document.createElement('div'); th.className = 'thumb'; th.title = 'Tap to change the photo';
            function paint() {
              th.style.backgroundImage = p.image_url ? 'url("' + String(p.image_url).replace(/"/g, '%22') + '")' : '';
              empty.style.display = p.image_url ? 'none' : 'flex';
            }
            var empty = document.createElement('div'); empty.className = 'empty'; empty.textContent = 'No photo yet';
            var lbl = document.createElement('div'); lbl.className = 'chg'; lbl.textContent = 'Tap to change photo';
            th.appendChild(empty); th.appendChild(lbl); paint();
            th.onclick = function () { pickFor = { p: p, paint: paint, st: st }; $('file').value = ''; $('file').click(); };

            var name = document.createElement('textarea'); name.className = 'name'; name.value = p.name || ''; name.maxLength = 120; name.rows = 2;
            name.oninput = function () { grow(name); };
            name.onkeydown = function (e) { if (e.key === 'Enter') e.preventDefault(); };

            var price = document.createElement('input'); price.type = 'text'; price.inputMode = 'decimal'; price.className = 'price';
            price.value = p.price == null ? '' : String(p.price); price.placeholder = 'e.g. 45000';

            var meta = document.createElement('div'); meta.className = 'meta';
            meta.textContent = [p.major_category, p.sub_category].filter(Boolean).join(' · ');

            var btn = document.createElement('button'); btn.className = 'primary'; btn.textContent = 'Save';
            var st = document.createElement('div'); st.className = 'status';
            var foot = document.createElement('div'); foot.className = 'foot'; foot.appendChild(st); foot.appendChild(btn);

            btn.onclick = function () {
              var body = {};
              if (name.value !== (p.name || '')) body.name = name.value;
              if (price.value.trim() !== (p.price == null ? '' : String(p.price))) body.price = price.value;
              if (!Object.keys(body).length) { setStatus(st, 'Nothing changed', true); return; }
              btn.disabled = true; setStatus(st, 'Saving…', true);
              api('/api/admin/products/' + p.id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(function (b) {
                  Object.assign(p, b.product);
                  name.value = p.name || ''; price.value = p.price == null ? '' : String(p.price); grow(name);
                  setStatus(st, 'Saved ✓', true);
                })
                .catch(function (e) { setStatus(st, e.message, false); })
                .then(function () { btn.disabled = false; });
            };

            var f = document.createElement('div'); f.className = 'fields';
            f.appendChild(meta);
            f.appendChild(field('Product name', name));
            f.appendChild(field('Price in KSh (excl. VAT)', price));
            f.appendChild(foot);

            r.appendChild(th); r.appendChild(f);
            requestAnimationFrame(function () { grow(name); });
            return r;
          }

          // Shrink the photo in the browser first so phone photos upload fast and stay under the 6 MB limit.
          function resize(file) {
            return new Promise(function (resolve, reject) {
              var img = new Image(), url = URL.createObjectURL(file);
              img.onload = function () {
                var max = 1600, s = Math.min(1, max / Math.max(img.width, img.height));
                var c = document.createElement('canvas');
                c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
                var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
                ctx.drawImage(img, 0, 0, c.width, c.height);
                URL.revokeObjectURL(url);
                c.toBlob(function (b) { b ? resolve(b) : reject(new Error('Could not read that photo')); }, 'image/jpeg', 0.85);
              };
              img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('Please choose a JPG, PNG or WEBP photo')); };
              img.src = url;
            });
          }

          $('file').onchange = function () {
            var f = this.files && this.files[0], t = pickFor; if (!f || !t) return;
            setStatus(t.st, 'Uploading…', true);
            resize(f).then(function (blob) {
              return api('/api/admin/products/' + t.p.id + '/image', { method: 'POST', headers: { 'Content-Type': 'image/jpeg' }, body: blob });
            }).then(function (b) {
              Object.assign(t.p, b.product);
              t.paint();
              setStatus(t.st, 'Photo updated', true);
            }).catch(function (e) { setStatus(t.st, e.message, false); });
          };

          $('q').oninput = function () { query = this.value; shown = PAGE; render(); };
          $('more').onclick = function () { shown += PAGE; render(); };

          api('/api/admin/products').then(function (b) {
            all = b.products || []; render();
          }).catch(function (e) { $('count').textContent = ''; $('note').innerHTML = ''; var d = document.createElement('div'); d.className = 'msg'; d.textContent = e.message; $('note').appendChild(d); });
        })();
      </script>
    </>
  )}
</body>
</html>
