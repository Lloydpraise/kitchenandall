---
export const prerender = false;

import Layout from '../../layouts/layout.astro';
import { supabase } from '../../lib/supabase';
import ProductDetail from '../../components/ProductDetail';
import ProductCard from '../../components/productCard';
import { parseContent } from '../../lib/productContent';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categoryOf, categoryUrl, subCategoryUrl } from '../../lib/categories';
import { loadOffers, withOffer, withOffers } from '../../lib/offers';

const { slug } = Astro.params;
const liveOffers = await loadOffers(supabase);

const { data: rawProduct, error } = await supabase
  .from('products')
  .select('*')
  .eq('slug', slug)
  .single();
// On a live offer (Admin > Offers) price becomes the sale price and old_price the normal price
const product = rawProduct ? withOffer(rawProduct, liveOffers) : null;

// A product whose link was renamed keeps its old slugs in old_slugs: send visitors and Google to the new link
if (!product && slug) {
  const { data: moved } = await supabase
    .from('products')
    .select('slug')
    .contains('old_slugs', [slug])
    .limit(1)
    .maybeSingle();
  if (moved?.slug) return Astro.redirect(`/product/${moved.slug}`, 301);
}

// Fetch related products from the same category
let relatedProducts = [];
if (product) {
  const { data: related } = await supabase
    .from('products')
    .select('*')
    .eq('sub_category', product.sub_category)
    .neq('id', product.id)
    .limit(5);
  
  relatedProducts = withOffers(related, liveOffers);
}

const siteUrl = 'https://kitchenandall.co.ke';

// Home / Category / Sub-category / Product
const { category, sub } = product ? categoryOf(product) : { category: undefined, sub: undefined };
const crumbs = product
  ? [
      ...(category ? [{ name: category.name, href: categoryUrl(category) }] : [{ name: 'All Products', href: '/catalog' }]),
      ...(category && sub ? [{ name: sub.name, href: subCategoryUrl(category, sub) }] : []),
      { name: product.name },
    ]
  : []; // swap once you have the real domain

const content = product ? parseContent(product) : null;
const canonical = product ? (product.canonical_url || `${siteUrl}/product/${product.slug}`) : undefined;
// Meta description: the SEO field if present, otherwise the intro (never the whole long description)
const metaDescription = product
  ? (product.meta_description || (content?.intro || product.description || '').replace(/\s+/g, ' ').trim().slice(0, 155))
  : undefined;

// Product structured data for Google. If your Layout already prints Product schema, remove one of them.
const productJsonLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      image: product.image_url ? [product.image_url] : undefined,
      description: metaDescription,
      sku: String(product.id),
      url: canonical,
      offers: {
        '@type': 'Offer',
        url: canonical,
        priceCurrency: 'KES',
        price: Number(product.price),
        // On sale: also give Google the normal price, so it can show it crossed out next to the sale price.
        ...(product.offer ? {
          priceSpecification: [
            { '@type': 'UnitPriceSpecification', price: Number(product.price), priceCurrency: 'KES' },
            { '@type': 'UnitPriceSpecification', priceType: 'https://schema.org/StrikethroughPrice', price: Number(product.offer.original_price), priceCurrency: 'KES' },
          ],
        } : {}),
        ...(product.offer?.ends_at ? { priceValidUntil: new Date(Date.parse(product.offer.ends_at) - 1000).toISOString().slice(0, 10) } : {}),
        itemCondition: 'https://schema.org/NewCondition',
        availability: (product.stock_quantity ?? 20) > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      },
    }
  : null;
---

<Layout
  title={product ? (product.meta_title || product.name) : "Product not found"}
  description={metaDescription}
  canonicalUrl={canonical}
  productOffer={product?.offer ? { ...product.offer, price: Number(product.price) } : undefined}
>
  <main class="min-h-[calc(100vh-7rem)] bg-slate-50">
    {product ? (
      <>
        <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
        <div class="bg-slate-100">
          <Breadcrumbs items={crumbs} class="mx-auto max-w-7xl px-4 pt-8 lg:pt-12" />
        </div>
        <ProductDetail product={product} client:load />

        {/* You May Also Like Section */}
        {relatedProducts.length > 0 && (
          <section class="bg-white border-t border-slate-200 py-16">
            <div class="max-w-7xl mx-auto px-4">
              <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
                <div>
                  <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tight">You May Also Like</h2>
                  <div class="h-1.5 w-20 bg-orange-600 mt-3"></div>
                </div>
                {category && (
                  <a href={sub ? subCategoryUrl(category, sub) : categoryUrl(category)} class="text-orange-600 font-black uppercase text-sm tracking-widest hover:underline">
                    All {(sub || category).name}
                  </a>
                )}
              </div>
              <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 lg:gap-6">
                {relatedProducts.map((relatedProduct) => (
                  <ProductCard product={relatedProduct} client:visible />
                ))}
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="mx-auto flex min-h-[60vh] max-w-4xl items-center justify-center px-4 py-24 text-center">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-16 shadow-2xl">
          <p class="text-sm uppercase tracking-[0.35em] text-orange-600 font-black">Product not found</p>
          <h1 class="mt-6 text-3xl font-black text-slate-900">Sorry, we couldn't find that item.</h1>
          <p class="mt-4 text-slate-600">The product may have been removed or the link is invalid.</p>
          <a href="/" class="mt-8 inline-flex rounded-full bg-orange-600 px-8 py-4 text-sm font-black uppercase tracking-[0.25em] text-white transition hover:bg-orange-700">Back to home</a>
        </div>
      </div>
    )}
  </main>
</Layout>
