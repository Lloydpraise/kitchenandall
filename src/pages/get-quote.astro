---
import Layout from '../layouts/layout.astro';
import GetQuoteForm from '../components/GetQuoteForm';
---

<Layout
  title="Get a Free Quote — Kitchen And All"
  description="Request a free consultation for your commercial kitchen equipment, layout, or fabrication project."
>
  <section class="min-h-[60vh] bg-slate-50 px-4 py-16">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-3xl font-black text-slate-900 uppercase tracking-tight">Get a Free Consultation</h1>
        <p class="mt-4 text-slate-600">Tell us about your project and we'll get back to you with a tailored quote.</p>
      </div>
      <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
        <GetQuoteForm client:load />
      </div>
    </div>
  </section>
</Layout>