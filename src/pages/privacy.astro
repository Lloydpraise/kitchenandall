---
export const prerender = false;

import Layout from '../layouts/layout.astro';
import { supabase } from '../lib/supabase';
import { marked } from 'marked';

const { data: page } = await supabase
  .from('site_pages')
  .select('*')
  .eq('slug', 'privacy')
  .single();

const contentHtml = page ? marked.parse(page.content) : '';
---

<Layout
  title={page?.meta_title || 'Terms of Service'}
  description={page?.meta_description}
>
  <main class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-black text-slate-900 leading-tight">{page?.title || 'Terms of Service'}</h1>
    <div class="prose prose-slate prose-headings:font-black prose-a:text-orange-600 max-w-none mt-8" set:html={contentHtml} />
  </main>
</Layout>