---
import Layout from '../layouts/layout.astro';
---

<Layout>
  <section class="min-h-[60vh] bg-slate-50 px-4 py-28">
    <div class="mx-auto max-w-4xl rounded-[2rem] bg-white border border-slate-200 p-14 shadow-2xl">
      <p class="text-sm uppercase tracking-[0.35em] text-orange-600 font-black">Privacy Policy</p>
      <h1 class="mt-6 text-4xl font-black text-slate-900">Your privacy matters</h1>
      <p class="mt-6 text-slate-600 leading-relaxed">This is a placeholder privacy policy page. Add your actual privacy policy details here to explain how customer information is handled and protected.</p>
    </div>
  </section>
</Layout>
