---
export const prerender = false;

import Layout from '../layouts/layout.astro';
import ProductCard from '../components/productCard';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { supabase } from '../lib/supabase';
import { endsLabel, loadOffers, withOffers } from '../lib/offers';

// Every product in a live offer (Admin > Offers), biggest discount first
const live = await loadOffers(supabase);
const ids = [...live.byProduct.keys()];
let products: any[] = [];
if (ids.length) {
  const { data, error } = await supabase.from('products').select('*').in('id', ids).order('id');
  if (error) console.error('Deals query error:', error);
  products = withOffers(data, live).sort((a: any, b: any) => (b.offer?.percent || 0) - (a.offer?.percent || 0));
}
const offer = live.headline;
const ends = offer ? endsLabel(offer.ends_at) : '';
const title = offer ? `${offer.badge}: ${Number(offer.percent_off)}% Off Kitchen Equipment in Kenya | Kitchen And All` : 'Deals | Kitchen And All';
const description = offer
  ? `${offer.badge} at Kitchen And All: ${Number(offer.percent_off)}% off ${products.length} commercial kitchen products, high-quality stainless steel, delivered across Kenya.${ends ? ` Ends ${ends}.` : ''}`
  : 'Current deals on commercial kitchen equipment from Kitchen And All, Nairobi.';
---
<Layout title={title} description={description} canonicalUrl="https://kitchenandall.co.ke/deals" noindex={!products.length}>
  <div class="min-h-screen bg-slate-50">
    <section class="relative overflow-hidden bg-black text-white py-16">
      <div class="max-w-7xl mx-auto px-4 relative">
        <Breadcrumbs items={[{ name: 'Deals' }]} class="mb-6" dark />
        {offer ? (
          <>
            <p class="text-xs font-black uppercase tracking-[0.4em] text-orange-500">{offer.badge}</p>
            <h1 class="mt-3 text-4xl lg:text-6xl font-black uppercase tracking-tighter"><span class="bf-glow">{Number(offer.percent_off)}% off</span> {products.length} products</h1>
            <p class="mt-4 text-slate-300 text-lg max-w-2xl">Prices below already include the discount. High-quality stainless steel work, quick delivery and guidance at every step.{ends ? ` The sale ends ${ends}.` : ''}</p>
          </>
        ) : (
          <>
            <h1 class="text-4xl lg:text-5xl font-black uppercase tracking-tighter">Deals</h1>
            <p class="mt-4 text-slate-300 text-lg max-w-2xl">There is no sale running right now. Check back soon, or ask us for a quote.</p>
          </>
        )}
      </div>
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1.5 bf-stripe"></div>
    </section>

    <main class="max-w-7xl mx-auto px-4 py-16">
      {products.length > 0 ? (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 lg:gap-6">
          {products.map((product) => (
            <ProductCard product={product} client:visible />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <a href="/catalog" class="inline-flex rounded-full bg-orange-600 px-8 py-4 text-sm font-black uppercase tracking-[0.25em] text-white hover:bg-orange-700">See all products</a>
        </div>
      )}
    </main>
  </div>
</Layout>
