---
export const prerender = false;

import Layout from '../layouts/layout.astro';
import { supabase } from '../lib/supabase';
import { marked } from 'marked';

const { data: page } = await supabase
  .from('site_pages')
  .select('*')
  .eq('slug', 'terms')
  .single();

const contentHtml = page ? marked.parse(page.content) : '';
---

<Layout
  title={page?.meta_title || 'Terms of Service | Kitchen And All'}
  description={page?.meta_description || 'Terms and conditions for purchases, custom fabrication, and installation services from Kitchen And All in Kenya.'}
>
  <section class="min-h-[60vh] bg-slate-50 px-4 py-28">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-2xl md:p-14">
      <p class="text-sm font-black uppercase tracking-[0.35em] text-orange-600">Terms of Service</p>
      <h1 class="mt-6 text-4xl font-black text-slate-900">{page?.title || 'Terms and conditions'}</h1>
      <div class="prose prose-slate prose-headings:font-black prose-a:text-orange-600 max-w-none mt-8 leading-relaxed text-slate-600" set:html={contentHtml} />
    </div>
  </section>
</Layout>