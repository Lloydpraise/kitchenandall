---
import Layout from '../layouts/layout.astro';
---

<Layout>
  <section class="min-h-[60vh] bg-slate-50 px-4 py-28">
    <div class="mx-auto max-w-4xl rounded-[2rem] bg-white border border-slate-200 p-14 shadow-2xl">
      <p class="text-sm uppercase tracking-[0.35em] text-orange-600 font-black">Terms of Service</p>
      <h1 class="mt-6 text-4xl font-black text-slate-900">Terms and conditions</h1>
      <p class="mt-6 text-slate-600 leading-relaxed">This is a placeholder terms page. Replace this with your full terms of service and customer agreement text when ready.</p>
    </div>
  </section>
</Layout>
