---
import Layout from '../layouts/layout.astro';
import CheckoutForm from '../components/CheckoutForm';
---

<Layout title="Checkout — Kitchen And All">
  <section class="min-h-[60vh] bg-slate-50 px-4 py-16">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-3xl font-black text-slate-900 uppercase tracking-tight mb-2">Checkout</h1>
      <div class="h-1.5 w-20 bg-orange-600 mb-10"></div>
      <CheckoutForm client:load />
    </div>
  </section>
</Layout>